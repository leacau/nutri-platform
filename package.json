{
  "name": "nutri-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n EMU,API,WEB -c auto \"npm:emulators\" \"npm:dev:api\" \"npm:dev:web\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nutri-platform",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "firebase-tools": "^13.0.2",
    "tailwindcss": "^3.4.19"
  }
}
